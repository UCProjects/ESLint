{
  "name": "eslint-config-ucprojects",
  "version": "1.0.0",
  "description": "Shared ESLint flat config for UCProjects",
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "lint": "eslint ."
  },
  "peerDependencies": {
    "eslint": "^9.0.0"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "eslint-config-airbnb-base": {
      "eslint": "$eslint"
    }
  },
  "devDependencies": {
    "eslint": "^9.39.5"
  }
}
